# ==============================================================================
# FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier sous le nom '.env' et renseignez vos valeurs réelles.
# Le fichier '.env' est ignoré par Git pour des raisons de sécurité.
# ==============================================================================

# 1. Identifiants AWS (AWS Academy Learner Lab)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# 2. Clé API Google Gemini (Pour l'assistant IA Text-to-SQL)
# Obtenez-la gratuitement sur : https://aistudio.google.com/
GEMINI_API_KEY=
